RAILS_ENV=development

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=activeadmin_dev

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=activeadmindemo

# Que Job
WORKER_HIGH_COUNT=2
WORKER_HIGH_PRIORITIES=0

WORKER_MIXED_COUNT=2
WORKER_MIXED_PRIORITES=5,10

WORKER_LOG_LEVEL=debug
WORKER_POLL_INTERVAL=10

# Mailhog
MAILHOG_HOST=mailhog
MAILHOG_PORT=1025

# PGAdmin
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=password